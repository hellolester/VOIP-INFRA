# firewall-rules.example
#
# ILLUSTRATIVE TEMPLATE ONLY. This repository does not assume which
# firewall implementation is actually in use on this installation
# (Issabel's built-in firewall UI, iptables/firewalld directly on the
# VM, and/or the Proxmox VM firewall on vmbr1 for VM 200 could all be
# in play). Adapt the concepts below to whatever is actually deployed,
# and verify actual ports/ranges before applying — see
# docs/rtp-and-firewall.md.
#
# Do NOT run these as-is. Replace every <PLACEHOLDER> first, and
# confirm the real SIP port and RTP range on the live system.

# ---------------------------------------------------------------
# Example using iptables syntax (adapt to firewalld/Issabel UI/Proxmox
# firewall as appropriate for the actual system):
# ---------------------------------------------------------------

# Web management — restrict to known admin source(s) where possible
# iptables -A INPUT -p tcp -s <ADMIN_IP_OR_RANGE> --dport 80  -j ACCEPT
# iptables -A INPUT -p tcp -s <ADMIN_IP_OR_RANGE> --dport 443 -j ACCEPT

# SSH — restrict to known admin source(s) where possible
# iptables -A INPUT -p tcp -s <ADMIN_IP_OR_RANGE> --dport 22 -j ACCEPT

# SIP signaling — verify actual port; restrict to provider IP(s) if stable
# iptables -A INPUT -p udp -s <SIP_PROVIDER_IP> --dport <SIP_PORT> -j ACCEPT

# RTP media — verify actual configured range before opening
# iptables -A INPUT -p udp -s <SIP_PROVIDER_IP> --dport <RTP_PORT_RANGE_START>:<RTP_PORT_RANGE_END> -j ACCEPT

# Default posture: deny everything else inbound that isn't explicitly
# needed. Do NOT flush/replace existing rules blindly — review current
# rules first and apply changes incrementally.
