# sip-provider.env.example
#
# Copy this file to a LOCAL, GIT-IGNORED file (e.g. `.env` or
# `sip-provider.env`) and fill in real values there. This .example
# file itself must never contain real credentials, and the copy you
# fill in must never be committed to Git — see .gitignore and
# docs/security.md.
#
# cp templates/sip-provider.env.example .env

SIP_PROVIDER=<SIP_PROVIDER>
SIP_SERVER=<SIP_SERVER>
SIP_DOMAIN=<SIP_DOMAIN>
SIP_USERNAME=<SIP_USERNAME>
SIP_PASSWORD=<SIP_PASSWORD>
SIP_PROVIDER_IP=<SIP_PROVIDER_IP>

# Verify against provider docs and live Asterisk config — do not
# assume 5060/udp. See docs/sip-trunk.md.
SIP_PORT=<SIP_PORT>

# Verify against live Asterisk rtp.conf / "core show settings" output.
# Do not assume 10000-20000. See docs/rtp-and-firewall.md.
RTP_PORT_RANGE=<RTP_PORT_RANGE>
